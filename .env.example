# VASTHRAM Store Environment Configuration
# Copy this file to .env or .env.local to configure your store's WhatsApp and Contact numbers.
# .env is included in .gitignore to keep your numbers private and protected from public GitHub repos.

# WhatsApp number for orders and customer inquiries (include country code without + or spaces, e.g. 919876543210)
VITE_WHATSAPP_NUMBER=918610236842

# Public contact phone displayed in footer / contact sections
VITE_CONTACT_PHONE=+91 86102 36842
